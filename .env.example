MYSQL_DATABASE=playville
MYSQL_USER=playville
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# At least 32 characters. Generate a unique value for each environment.
PLAYVILLE_JWT_SECRET=replace-with-a-random-256-bit-secret

# Optional SMTP settings.
PLAYVILLE_SMTP_HOST=smtp.example.com
PLAYVILLE_SMTP_PORT=587
PLAYVILLE_SMTP_USERNAME=
PLAYVILLE_SMTP_PASSWORD=
PLAYVILLE_SMTP_AUTH=true
PLAYVILLE_SMTP_STARTTLS=true
PLAYVILLE_PUBLIC_DISCLAIMER_URL=https://app.example.com/public/disclaimer
PLAYVILLE_DISCLAIMER_FROM_EMAIL=no-reply@example.com
PLAYVILLE_EMAIL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
PLAYVILLE_WHATSAPP_ACCESS_TOKEN=